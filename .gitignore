# build artifacts (never commit)
node_modules/
dist/
resources/

# logs
*.log

# icon source image (copyright risk - use your own when publishing)
build/source-icon.png

# re-include scripts/lib (build dependency; root .gitignore has a bare lib/ rule)
!scripts/lib/
!scripts/lib/*.cjs

