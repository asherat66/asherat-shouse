# 依赖
node_modules/

# 补丁备份（install-v6 / patch 脚本自动生成）
*.bak-installv6-*
*.bak-install-*
*.bak-v6u-*

# 历史版本备份
*.v66-*
*.pre-*

# 字体源（80MB，需时从 GitHub 重新下载，见 tools/subset_fonts.py FONTS 清单）
tools/font-src/

# Python 缓存
__pycache__/
*.pyc

# 字体二进制（不入库；权威位置在字体根目录 I:\字体）
tools/*.ttf
tools/*.woff2
tools/*.otf

# 发布包目录（生成物，由维护者按需整理，不入库）
release/

# 系统与临时
.DS_Store
Thumbs.db
.write_test
.writetest
.wtest

# 测试临时产物
tests/tmp-*

# 市场投稿文件（提交给 awesome-dsh-plugin 的 YAML，不属于本仓库）
marketplace-submission/

# 日志
*.log
